# FlexCart Backend (Example)
# Copy to .env and fill your values

# Server
PORT=5000
NODE_ENV=development

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=flexcart_db

# JWT
JWT_SECRET=change_me
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change_me
JWT_REFRESH_EXPIRES_IN=30d

# Uploads
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# AI (optional)
AI_API_KEY=
AI_API_URL=https://api.openai.com/v1

# Super Admin seed (set before first deploy)
SUPER_ADMIN_EMAIL=admin@yourdomain.com
SUPER_ADMIN_PASSWORD=ChangeThisPassword@2025

# Frontend CORS origin
# PRODUCTION: set to your Vercel frontend URL (e.g. https://flexcart.vercel.app)
# DEVELOPMENT: http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Public URL of the backend — used for SSLCommerz callback URLs and AI image resolution.
# PRODUCTION: set to your Render backend URL (e.g. https://flexcart-api.onrender.com)
#   SSLCommerz POSTs success/fail/cancel/ipn to ${BACKEND_URL}/api/payment/<action>
#   These must be publicly reachable HTTPS URLs — localhost will never work in production.
# DEVELOPMENT: http://localhost:3000 (SSLCommerz callbacks won't reach you locally — use ngrok or sandbox test mode)
BACKEND_URL=http://localhost:5000
BACKEND_PUBLIC_URL=http://localhost:5000

# SSLCommerz Payment Gateway
# Sandbox credentials — replace with live credentials when going live
# Get sandbox credentials at: https://developer.sslcommerz.com/registration/
# IMPORTANT: SSL_IS_LIVE=true requires BACKEND_URL and FRONTEND_URL to be set to
#   production HTTPS URLs. The server will refuse to start in production if these
#   point to localhost.
SSL_STORE_ID=your_sandbox_store_id
SSL_STORE_PASSWORD=your_sandbox_store_password
SSL_IS_LIVE=false

# Optional Python microservices
# VS_SERVICE_URL=http://localhost:5001
# REC_SERVICE_URL=http://localhost:5003
